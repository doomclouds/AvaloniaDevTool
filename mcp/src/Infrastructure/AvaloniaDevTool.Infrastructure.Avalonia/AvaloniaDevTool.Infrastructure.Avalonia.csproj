<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="../AvaloniaDevTool.Infrastructure.Rpc/AvaloniaDevTool.Infrastructure.Rpc.csproj" />
        <PackageReference Include="Avalonia"
            Version="$(AvaloniaVersion)" />
        <PackageReference Include="Avalonia.Markup.Xaml.Loader"
            Version="$(AvaloniaVersion)" />
        <InternalsVisibleTo Include="AvaloniaDevTool.Agent" />
        <InternalsVisibleTo Include="AvaloniaDevTool.Agent.Tests" />
    </ItemGroup>
    <ItemGroup>
        <None Update="ThirdParty/*"
            TargetPath="ThirdParty/AvaloniaDevTool.Agent/%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
