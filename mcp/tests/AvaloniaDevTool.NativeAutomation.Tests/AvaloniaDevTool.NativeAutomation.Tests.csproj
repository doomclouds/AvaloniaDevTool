            ReferenceOutputAssembly="false"
            SkipGetTargetFrameworkProperties="true"
            Condition="'$(OS)' == 'Windows_NT'" />
    </ItemGroup>
    <ItemGroup>
        <Compile
            Include="../../src/Infrastructure/AvaloniaDevTool.Infrastructure.Windows/Coordinates/NativeCoordinateSpace.cs"
            Link="NativeWorker/NativeCoordinateSpace.cs" />
        <Compile
            Include="../../src/Infrastructure/AvaloniaDevTool.Infrastructure.Windows/Identity/NativeWindowLifetimeMonitor.cs"
