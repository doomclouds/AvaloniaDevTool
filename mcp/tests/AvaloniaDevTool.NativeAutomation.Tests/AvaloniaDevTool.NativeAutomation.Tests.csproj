            Version="18.11.0" />
        <PackageReference Include="xunit.v3"
            Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio"
            Version="4.0.1"
            PrivateAssets="all" />
        <ProjectReference
            Include="../../src/Infrastructure/AvaloniaDevTool.Infrastructure.Execution/AvaloniaDevTool.Infrastructure.Execution.csproj" />
        <ProjectReference
            Include="../../src/Hosts/AvaloniaDevTool.NativeAutomation.Worker/AvaloniaDevTool.NativeAutomation.Worker.csproj"
