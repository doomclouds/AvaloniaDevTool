                ItemName="NativeTestPaths" />
        </MSBuild>
        <ItemGroup>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>NativeTestPaths</_Parameter1>
                <_Parameter2>@(NativeTestPaths, '|')</_Parameter2>
