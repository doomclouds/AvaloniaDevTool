{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "avalonia-devtool",
  "version": "0.1.4",
  "description": "通过 MCP 发现和原生热附加 Windows Avalonia 应用，检查控件、执行交互、截图录屏及本机或远程诊断。",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "onboardingSkill": "./skills/avalonia-devtool/SKILL.md",
      "interface": {
        "displayName": "Avalonia DevTool",
        "shortDescription": "Avalonia 界面检查与调试",
        "composerIcon": "./assets/avalonia.png",
        "logo": "./assets/avalonia.png"
      }
    }
  }
}
