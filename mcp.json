{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "avalonia": {
      "type": "stdio",
      "command": "dotnet",
      "args": ["run", "--file", "${PLUGIN_ROOT}/mcp/AvaloniaDevTool.cs", "--no-build", "--no-restore", "--configuration", "Release", "--", "mcp"],
      "cwd": "${PLUGIN_ROOT}/mcp",
      "env": { "DOTNET_NOLOGO": "1", "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1" }
    }
  }
}
