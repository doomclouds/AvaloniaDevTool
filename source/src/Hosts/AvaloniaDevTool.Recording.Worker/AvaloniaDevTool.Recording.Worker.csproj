    <ItemGroup>
        <ProjectReference Include="../../Contracts/AvaloniaDevTool.Contracts/AvaloniaDevTool.Contracts.csproj" />
        <Reference Include="ScreenRecorderLib">
            <HintPath>../../../native/win-x64/recording/ScreenRecorderLib.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <None Include="../../../native/win-x64/recording/ScreenRecorderLib.manifest.json"
