diff --git a/ScreenRecorderLibNative/EncodingTexturePool.h b/ScreenRecorderLibNative/EncodingTexturePool.h
new file mode 100644
index 0000000..ac28ccc
--- /dev/null
+++ b/ScreenRecorderLibNative/EncodingTexturePool.h
@@ -0,0 +1,205 @@
+#pragma once
+#include <atlbase.h>
+#include <d3d11.h>
+#include <mfidl.h>
+#include <mferror.h>
+#include <atomic>
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <memory>
+#include <mutex>
+#include <new>
+#include <vector>
+
+// The pool owns texture storage. A tracked sample lends a slot to Media Foundation;
+// only its final external-reference callback can make that slot reusable again.
+class EncodingTexturePool final
+{
+private:
+	struct Slot
+	{
+		CComPtr<ID3D11Texture2D> Texture;
+		CComPtr<IMFAsyncCallback> Callback;
+		bool InUse = false;
+	};
+	struct State
+	{
+		std::mutex Mutex;
+		std::condition_variable Available;
+		std::vector<Slot> Slots;
+		CComPtr<ID3D11Device> Device;
+		D3D11_TEXTURE2D_DESC Desc{};
+		bool Closed = false;
+		std::atomic<int> Capacity{0};
+		std::atomic<int> Allocated{0};
+		std::atomic<int> InUse{0};
+		std::atomic<int> PeakInUse{0};
+		std::atomic<LONGLONG> Reuses{0};
+		std::atomic<LONGLONG> Timeouts{0};
+		// Nominal pixel bytes at peak; driver allocation padding is not included.
+		std::atomic<LONGLONG> Bytes{0};
+	};
+
+	static void Return(const std::shared_ptr<State>& state, size_t index)
+	{
+		{
+			std::lock_guard<std::mutex> lock(state->Mutex);
+			if (index >= state->Slots.size() || !state->Slots[index].InUse) return;
+			state->Slots[index].InUse = false;
+			--state->InUse;
+		}
+		state->Available.notify_one();
+	}
+
+	class ReturnedSample final : public IMFAsyncCallback
+	{
+	public:
+		ReturnedSample(const std::shared_ptr<State>& state, size_t slot) : m_State(state), m_Slot(slot) {}
+		STDMETHODIMP QueryInterface(REFIID iid, void** result) override
+		{
+			if (!result) return E_POINTER;
+			*result = nullptr;
+			if (iid == __uuidof(IUnknown) || iid == __uuidof(IMFAsyncCallback)) {
+				*result = static_cast<IMFAsyncCallback*>(this);
+				AddRef();
+				return S_OK;
+			}
+			return E_NOINTERFACE;
+		}
+		STDMETHODIMP_(ULONG) AddRef() override { return ++m_References; }
+		STDMETHODIMP_(ULONG) Release() override
+		{
+			const ULONG remaining = --m_References;
+			if (!remaining) delete this;
+			return remaining;
+		}
+		STDMETHODIMP GetParameters(DWORD*, DWORD*) override { return E_NOTIMPL; }
+		STDMETHODIMP Invoke(IMFAsyncResult*) override
+		{
+			if (auto state = m_State.lock()) Return(state, m_Slot);
+			return S_OK;
+		}
+	private:
+		std::atomic<ULONG> m_References{1};
+		std::weak_ptr<State> m_State;
+		size_t m_Slot;
+	};
+
+public:
+	class Lease final
+	{
+		friend class EncodingTexturePool;
+	public:
+		Lease() = default;
+		Lease(const Lease&) = delete;
+		Lease& operator=(const Lease&) = delete;
+		~Lease() { if (m_State && !m_Tracked) Return(m_State, m_Slot); }
+		ID3D11Texture2D* Texture() const { return m_Texture; }
+		IMFAsyncCallback* Callback() const { return m_Callback; }
+		void Tracked() { m_Tracked = true; }
+	private:
+		std::shared_ptr<State> m_State;
+		size_t m_Slot = 0;
+		CComPtr<ID3D11Texture2D> m_Texture;
+		CComPtr<IMFAsyncCallback> m_Callback;
+		bool m_Tracked = false;
+	};
+
+	EncodingTexturePool() : m_State(std::make_shared<State>()) {}
+	~EncodingTexturePool() { Close(); }
+
+	HRESULT Acquire(ID3D11Device* device, const D3D11_TEXTURE2D_DESC& desc, Lease& lease)
+	{
+		const auto state = m_State;
+		std::unique_lock<std::mutex> lock(state->Mutex);
+		if (state->Closed) return MF_E_SHUTDOWN;
+		if (desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM || desc.ArraySize != 1 ||
+			desc.MipLevels != 1 || desc.SampleDesc.Count != 1 || !desc.Width || !desc.Height)
+			return MF_E_INVALIDMEDIATYPE;
+		const LONGLONG bytes = static_cast<LONGLONG>(desc.Width) * desc.Height * 4;
+		if (state->Capacity == 0) {
+			// Eight BGRA frames still fit at the worker's maximum 1920 x 1920 canvas.
+			constexpr LONGLONG Budget = 128LL * 1024 * 1024;
+			const auto capacity = static_cast<int>((std::min)(8LL, Budget / bytes));
+			if (capacity < 2) return E_OUTOFMEMORY;
+			state->Desc = desc;
+			state->Device = device;
+			state->Capacity = capacity;
+		} else if (state->Device != device || state->Desc.Width != desc.Width || state->Desc.Height != desc.Height ||
+			state->Desc.Format != desc.Format || state->Desc.BindFlags != desc.BindFlags ||
+			state->Desc.Usage != desc.Usage || state->Desc.CPUAccessFlags != desc.CPUAccessFlags ||
+			state->Desc.MiscFlags != desc.MiscFlags) {
+			return MF_E_INVALIDMEDIATYPE;
+		}
+
+		const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(250);
+		for (;;) {
+			if (state->Closed) return MF_E_SHUTDOWN;
+			for (size_t index = 0; index < state->Slots.size(); index++) {
+				if (!state->Slots[index].InUse) {
+					++state->Reuses;
+					Assign(state, index, lease);
+					return S_OK;
+				}
+			}
+			if (state->Slots.size() < static_cast<size_t>(state->Capacity.load())) {
+				Slot slot;
+				HRESULT hr = device->CreateTexture2D(&desc, nullptr, &slot.Texture);
+				if (FAILED(hr)) return hr;
+				slot.Callback.Attach(new (std::nothrow) ReturnedSample(state, state->Slots.size()));
+				if (!slot.Callback) return E_OUTOFMEMORY;
+				state->Slots.push_back(slot);
+				state->Allocated = static_cast<int>(state->Slots.size());
+				state->Bytes = bytes * state->Allocated.load();
+				Assign(state, state->Slots.size() - 1, lease);
+				return S_OK;
+			}
+			if (state->Available.wait_until(lock, deadline) == std::cv_status::timeout) {
+				if (state->Closed) return MF_E_SHUTDOWN;
+				if (std::any_of(state->Slots.begin(), state->Slots.end(),
+					[](const Slot& slot) { return !slot.InUse; })) continue;
+				++state->Timeouts;
+				return HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+			}
+		}
+	}
+
+	void Close()
+	{
+		const auto state = m_State;
+		{
+			std::lock_guard<std::mutex> lock(state->Mutex);
+			state->Closed = true;
+			for (auto& slot : state->Slots) {
+				slot.Texture.Release();
+				slot.Callback.Release();
+			}
+			state->Device.Release();
+		}
+		state->Available.notify_all();
+	}
+
+	bool Observed() const { return m_State->Capacity != 0; }
+	int Capacity() const { return m_State->Capacity; }
+	int Allocated() const { return m_State->Allocated; }
+	int InUse() const { return m_State->InUse; }
+	int PeakInUse() const { return m_State->PeakInUse; }
+	LONGLONG Reuses() const { return m_State->Reuses; }
+	LONGLONG Timeouts() const { return m_State->Timeouts; }
+	LONGLONG Bytes() const { return m_State->Bytes; }
+
+private:
+	static void Assign(const std::shared_ptr<State>& state, size_t index, Lease& lease)
+	{
+		auto& slot = state->Slots[index];
+		slot.InUse = true;
+		const auto inUse = ++state->InUse;
+		if (inUse > state->PeakInUse) state->PeakInUse = inUse;
+		lease.m_State = state;
+		lease.m_Slot = index;
+		lease.m_Texture = slot.Texture;
+		lease.m_Callback = slot.Callback;
+	}
+	std::shared_ptr<State> m_State;
+};
