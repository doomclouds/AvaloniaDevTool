+static bool IsStaticPngOverlay(RECORDING_SOURCE_BASE* source)
+{
+	if (source->Type != RecordingSourceType::Picture || !dynamic_cast<RECORDING_OVERLAY*>(source))
+		return false;
+	constexpr char pngSignature[] = "\x89PNG\r\n\x1a\n";
+	if (source->SourceStream) {
+		const auto signature = ReadFileSignature(source->SourceStream);
+		return signature.size() >= 8 && memcmp(signature.data(), pngSignature, 8) == 0;
+	}
+	// The general source sniffing helper opens files in text mode. PNG signatures
+	// contain CR/LF and Ctrl-Z, so this optimization must read them as binary.
+	FILE* file = nullptr;
+	if (_wfopen_s(&file, source->SourcePath.c_str(), L"rb") != 0 || !file) return false;
+	char signature[8]{};
+	const auto length = fread(signature, 1, sizeof(signature), file);
+	fclose(file);
+	return length == sizeof(signature) && memcmp(signature, pngSignature, sizeof(signature)) == 0;
+}
+
+static bool ShareStaticImageDevice(ID3D11Device* device, ID3D11DeviceContext* context, DX_RESOURCES* resources)
+{
+	CComPtr<ID3D10Multithread> protection;
+	if (FAILED(context->QueryInterface(IID_PPV_ARGS(&protection))) || !protection->GetMultithreadProtected())
+		return false;
+	resources->Device = device;
+	resources->Device->AddRef();
+	resources->Context = context;
+	resources->Context->AddRef();
+	// Debug remains null; CleanDx owns exactly these two added references.
+	return true;
+}
+
+static HANDLE GetStaticImageSharedHandle(ID3D11DeviceContext* context, ID3D11Texture2D* texture)
+{
+	CComPtr<ID3D10Multithread> protection;
+	if (FAILED(context->QueryInterface(IID_PPV_ARGS(&protection)))) return nullptr;
+	// DXGI shared-handle access must not race use of this immediate context.
+	// Never hold this guard across a keyed-mutex wait or the overlay thread wait.
+	protection->Enter();
+	const auto handle = GetSharedHandle(texture);
+	protection->Leave();
+	return handle;
+}
