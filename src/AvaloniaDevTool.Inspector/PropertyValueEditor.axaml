<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AvaloniaDevTool.Inspector"
             x:Class="AvaloniaDevTool.Inspector.PropertyValueEditor"
             x:DataType="local:PropertyRowViewModel">
  <StackPanel Spacing="5">
    <TextBlock Text="{Binding CurrentValue}" IsVisible="{Binding CanEdit}" FontSize="11" Foreground="#6D7685"
               TextWrapping="Wrap" ToolTip.Tip="当前生效值；下方为尚未应用的编辑草稿。" />
    <TextBlock Text="{Binding CurrentValue}" IsVisible="{Binding IsReadOnly}" TextWrapping="Wrap"
               AutomationProperties.AutomationId="Inspector.ReadOnlyPropertyValue" />
    <CheckBox Content="{Binding Draft}" IsChecked="{Binding BooleanDraft, Mode=TwoWay}"
              IsThreeState="True" IsVisible="{Binding IsBooleanEditor}"
              AutomationProperties.AutomationId="Inspector.BooleanPropertyEditor" />
    <NumericUpDown Value="{Binding NumberDraft, Mode=TwoWay}" IsVisible="{Binding IsNumberEditor}"
                   Minimum="-79228162514264337593543950335" Maximum="79228162514264337593543950335"
                   FormatString="G" AutomationProperties.AutomationId="Inspector.NumberPropertyEditor" />
    <ComboBox ItemsSource="{Binding EnumChoices}" SelectedItem="{Binding EnumDraft, Mode=TwoWay}"
              IsVisible="{Binding IsEnumEditor}" HorizontalAlignment="Stretch"
              AutomationProperties.AutomationId="Inspector.EnumPropertyEditor" />
    <ItemsControl ItemsSource="{Binding FlagChoices}" IsVisible="{Binding IsFlagsEditor}"
                  AutomationProperties.AutomationId="Inspector.FlagsPropertyEditor">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="local:PropertyFlagChoiceViewModel">
          <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsColorEditor}">
      <Border Width="22" Height="22" Background="{Binding CurrentColor}" BorderBrush="#929AAA" BorderThickness="1"
              ToolTip.Tip="当前生效颜色；选择器仅修改草稿，点击应用后才修改目标。" />
      <ColorPicker Grid.Column="1" Color="{Binding DraftColor, Mode=TwoWay}" Margin="8,0,0,0"
                   AutomationProperties.AutomationId="Inspector.ColorPropertyEditor" />
    </Grid>
    <TextBox Text="{Binding Draft, Mode=TwoWay}" IsVisible="{Binding IsTextEditor}" MinWidth="100"
             ToolTip.Tip="{Binding TypeName}" AutomationProperties.AutomationId="Inspector.PropertyValue" />
    <TextBlock Text="{Binding DraftValidation}" IsVisible="{Binding HasDraftValidation}" Foreground="#B34150"
               TextWrapping="Wrap" FontSize="11" />
    <ContentControl Content="{Binding BrushEditor}" IsVisible="{Binding IsBrushEditor}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="local:BrushEditorViewModel">
          <local:BrushEditorView />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    <TextBlock Text="{Binding EditorNotice}" FontSize="11" Foreground="#6D7685" TextWrapping="Wrap" />
    <TextBlock Text="{Binding ContextNotice}" IsVisible="{Binding HasContextNotice}" FontSize="11" Foreground="#856A24" TextWrapping="Wrap" />
    <StackPanel IsVisible="{Binding HasPreview}" Spacing="4">
      <Button Content="预览属性值" Command="{Binding PreviewCommand}"
              AutomationProperties.AutomationId="Inspector.PreviewProperty" />
      <Border Background="#EEF1F6" Padding="4" IsVisible="{Binding HasPreviewImage}">
        <Image Source="{Binding PreviewImage}" MaxWidth="320" MaxHeight="240" Stretch="Uniform"
               HorizontalAlignment="Left" AutomationProperties.AutomationId="Inspector.PropertyPreviewImage" />
      </Border>
      <TextBlock Text="{Binding PreviewMessage}" FontSize="11" TextWrapping="Wrap"
                 AutomationProperties.AutomationId="Inspector.PropertyPreviewStatus" />
    </StackPanel>
  </StackPanel>
</UserControl>
