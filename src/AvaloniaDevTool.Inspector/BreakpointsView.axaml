<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaDevTool.Inspector.BreakpointsView" x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="14">
    <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
      <ComboBox Name="BreakpointKind" ItemsSource="{Binding BreakpointKinds}" SelectedIndex="{Binding BreakpointKindIndex, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.BreakpointKind" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding BreakpointMembers}" SelectedItem="{Binding SelectedBreakpointMember, Mode=TwoWay}"
                IsVisible="{Binding IsPropertyBreakpoint}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="Inspector.BreakpointProperty">
        <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding DeclaringType}" FontSize="10" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <CheckBox Grid.Column="2" Name="LimitBreakpointReceiver" Content="限定目标／接收节点" IsChecked="{Binding BreakpointSelectedObjectOnly, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.BreakpointReceiverFilter" />
    </Grid>
    <StackPanel Grid.Row="1" Spacing="6" Margin="0,8">
      <TextBox Name="BreakpointMember" Text="{Binding BreakpointMemberId, Mode=TwoWay}" PlaceholderText="完整 OwnerFullName:Member，例如 Avalonia.Controls.Button:Click" AutomationProperties.AutomationId="Inspector.BreakpointMemberId" />
      <TextBox Name="BreakpointReceiverId" Text="{Binding BreakpointObjectId, Mode=TwoWay}" IsVisible="{Binding BreakpointSelectedObjectOnly}" PlaceholderText="目标／接收节点 ID；留空使用树中所选对象" AutomationProperties.AutomationId="Inspector.BreakpointReceiverId" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsEventBreakpoint}">
        <TextBox Name="BreakpointSourceId" Text="{Binding BreakpointSourceObjectId, Mode=TwoWay}" PlaceholderText="事件 Source 对象 ID；留空表示全部源对象" AutomationProperties.AutomationId="Inspector.BreakpointSourceId" />
        <Button Grid.Column="1" Name="UseSelectedBreakpointSource" Content="所选对象作为源" Command="{Binding UseSelectedBreakpointSourceCommand}" AutomationProperties.AutomationId="Inspector.UseSelectedBreakpointSource" />
      </Grid>
      <TextBlock IsVisible="{Binding IsEventBreakpoint}" Text="Source 是实际 RaiseEvent 的对象；接收节点是路由经过的对象。两个条件独立组合。" FontSize="11" TextWrapping="Wrap" Foreground="#66758B" />
    </StackPanel>
    <WrapPanel Grid.Row="2">
      <TextBlock Text="累计命中次数" VerticalAlignment="Center" Margin="0,0,8,6" />
      <ComboBox ItemsSource="{Binding BreakpointComparisons}" SelectedItem="{Binding BreakpointComparisonChoice, Mode=TwoWay}" Width="85" Margin="0,0,8,6">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <TextBox Text="{Binding BreakpointCompareTo, Mode=TwoWay}" Width="75" Margin="0,0,12,6" AutomationProperties.AutomationId="Inspector.BreakpointCountCondition" />
      <CheckBox Content="启用" IsChecked="{Binding BreakpointEnabled, Mode=TwoWay}" Margin="0,0,10,6" />
      <CheckBox Content="记录日志" IsChecked="{Binding BreakpointLogMessage, Mode=TwoWay}" Margin="0,0,10,6" />
      <CheckBox Content="一次性" IsChecked="{Binding BreakpointRemoveOnHit, Mode=TwoWay}" Margin="0,0,10,6" />
      <CheckBox Content="暂停（需附加调试器）" IsChecked="{Binding BreakpointSuspend, Mode=TwoWay}" Margin="0,0,0,6" AutomationProperties.AutomationId="Inspector.BreakpointSuspend" />
    </WrapPanel>
    <WrapPanel Grid.Row="3">
      <Button Name="CreateBreakpoint" Content="新建" Command="{Binding CreateBreakpointCommand}" Classes="accent" Margin="0,0,7,7" AutomationProperties.AutomationId="Inspector.CreateBreakpoint" />
      <Button Name="UpdateBreakpoint" Content="更新所选" Command="{Binding UpdateBreakpointCommand}" Margin="0,0,7,7" AutomationProperties.AutomationId="Inspector.UpdateBreakpoint" />
      <Button Content="删除所选" Command="{Binding RemoveBreakpointCommand}" Margin="0,0,7,7" AutomationProperties.AutomationId="Inspector.RemoveBreakpoint" />
      <Button Content="计数归零" Command="{Binding ResetBreakpointCountCommand}" Margin="0,0,7,7" />
      <Button Content="刷新" Command="{Binding RefreshInspectionCommand}" Margin="0,0,0,7" />
    </WrapPanel>
    <TextBlock Grid.Row="4" Text="{Binding BreakpointSummary}" TextWrapping="Wrap" Foreground="#66758B" FontSize="11" Margin="0,0,0,8" />
    <Grid Grid.Row="5" RowDefinitions="*,5,*">
      <ListBox ItemsSource="{Binding Breakpoints}" SelectedItem="{Binding SelectedBreakpoint, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.Breakpoints">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto" Margin="4">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding MemberId}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding Id, StringFormat='断点 #{0}'}" FontSize="11" />
                  <TextBlock Text="{Binding Scope}" FontSize="11" />
                  <TextBlock Text="{Binding State}" FontSize="11" />
                  <TextBlock Text="{Binding HitCount, StringFormat='命中 {0} 次'}" FontSize="11" />
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="1" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Padding="9,5" Margin="8,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Row="1" Background="Transparent" HorizontalAlignment="Stretch" ResizeDirection="Rows" />
      <ListBox Grid.Row="2" ItemsSource="{Binding BreakpointHits}" SelectedItem="{Binding SelectedBreakpointHit, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.BreakpointHits">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4" Spacing="4">
              <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
              <WrapPanel>
                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" Margin="0,0,10,0" FontSize="11" />
                <TextBlock Text="{Binding BreakpointId, StringFormat='断点 #{0}'}" Margin="0,0,10,0" FontSize="11" />
                <TextBlock Text="{Binding HitCount, StringFormat='第 {0} 次'}" Margin="0,0,10,0" FontSize="11" />
                <TextBlock Text="{Binding ConditionMet, StringFormat='满足条件：{0}'}" Margin="0,0,10,0" FontSize="11" />
                <TextBlock Text="{Binding SuspendSkipped, StringFormat='跳过暂停：{0}'}" FontSize="11" />
              </WrapPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
