<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaDevTool.Inspector.ProtocolMonitorView" x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,2*" Margin="14">
    <WrapPanel>
      <Button Content="开始录制" Command="{Binding StartProtocolTraceCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="Inspector.ProtocolStart" />
      <Button Content="停止" Command="{Binding StopProtocolTraceCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="Inspector.ProtocolStop" />
      <Button Content="清空" Command="{Binding ClearProtocolTraceCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="Inspector.ProtocolClear" />
      <Button Content="读取" Command="{Binding RefreshProtocolTraceCommand}" Margin="0,0,12,8" AutomationProperties.AutomationId="Inspector.ProtocolRefresh" />
      <CheckBox Content="录制正文（可能含应用数据）" IsChecked="{Binding ProtocolCapturePayloads, Mode=TwoWay}"
                IsEnabled="{Binding CanConfigureProtocolCapture}" AutomationProperties.AutomationId="Inspector.ProtocolPayloads" />
    </WrapPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBox Text="{Binding ProtocolFilter, Mode=TwoWay}" PlaceholderText="筛选方法、状态或错误码" AutomationProperties.AutomationId="Inspector.ProtocolFilter" />
      <CheckBox Grid.Column="1" Content="仅错误" Margin="12,0,0,0" IsChecked="{Binding ProtocolErrorsOnly, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.ProtocolErrorsOnly" />
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding ProtocolTraceSummary}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="Inspector.ProtocolSummary" />
    <ListBox Grid.Row="3" ItemsSource="{Binding ProtocolTraceEntries}" SelectedItem="{Binding SelectedProtocolTrace, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.ProtocolEntries">
      <ListBox.ItemTemplate><DataTemplate>
        <Grid ColumnDefinitions="50,*,Auto" RowDefinitions="Auto,Auto" Margin="2">
          <TextBlock Text="{Binding Sequence}" />
          <TextBlock Grid.Column="1" Text="{Binding Method}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="{Binding State}" Margin="12,0,0,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Direction}" FontSize="11" Foreground="#66758B" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ErrorCode}" FontSize="11" Foreground="#A33030" />
        </Grid>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="4" Text="{Binding ProtocolTraceDetail}" TextWrapping="Wrap" Margin="0,8" AutomationProperties.AutomationId="Inspector.ProtocolDetail" />
    <TabControl Grid.Row="5">
      <TabItem Header="参数"><TextBox Text="{Binding ProtocolRequestText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" AutomationProperties.AutomationId="Inspector.ProtocolRequest" /></TabItem>
      <TabItem Header="响应"><TextBox Text="{Binding ProtocolResponseText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" AutomationProperties.AutomationId="Inspector.ProtocolResponse" /></TabItem>
    </TabControl>
  </Grid>
</UserControl>
