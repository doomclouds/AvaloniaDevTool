<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AvaloniaDevTool.Inspector"
             x:Class="AvaloniaDevTool.Inspector.BindingDetailsView" x:CompileBindings="False">
  <StackPanel Spacing="8" AutomationProperties.AutomationId="Inspector.BindingDetails">
    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" Foreground="#6653C0" />
    <Grid ColumnDefinitions="150,*,76" Margin="0,0,0,3">
      <TextBlock Text="字段" Foreground="#66758B" FontSize="11" />
      <TextBlock Grid.Column="1" Text="值（只读）" Foreground="#66758B" FontSize="11" Margin="8,0" />
      <TextBlock Grid.Column="2" Text="状态" Foreground="#66758B" FontSize="11" />
    </Grid>
    <ItemsControl ItemsSource="{Binding Fields}" AutomationProperties.AutomationId="Inspector.BindingFields">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="#E2E6EF" BorderThickness="0,0,0,1" Padding="0,5">
            <Grid ColumnDefinitions="150,*,76" RowDefinitions="Auto,Auto">
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
              <StackPanel Grid.Column="1" Spacing="3" Margin="8,0">
                <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding TypeName}" IsVisible="{Binding HasTypeName}" TextWrapping="Wrap" FontSize="10" Foreground="#718096" />
                <TextBlock Text="{Binding ObjectReference}" IsVisible="{Binding HasObjectReference}" TextWrapping="Wrap" FontSize="10" Foreground="#718096" />
                <Button Content="{Binding NavigateLabel}" Command="{Binding NavigateCommand}" IsVisible="{Binding HasNavigation}"
                        IsEnabled="{Binding CanNavigate}"
                        HorizontalAlignment="Left" Padding="8,4" AutomationProperties.AutomationId="Inspector.BindingNavigate" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="#66758B" FontSize="11" />
              <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Reason}" IsVisible="{Binding HasReason}"
                         TextWrapping="Wrap" Foreground="#856A24" FontSize="11" Margin="8,4,0,0" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel IsVisible="{Binding HasErrors}" Spacing="4">
      <TextBlock Text="错误与内部异常（可展开）" FontWeight="SemiBold" Foreground="#B34150" />
      <TreeView ItemsSource="{Binding Errors}" AutomationProperties.AutomationId="Inspector.BindingErrors">
        <TreeView.Styles>
          <Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="True" /></Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding InnerErrors}">
            <StackPanel Spacing="3" Margin="0,3">
              <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Foreground="#B34150" />
              <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ExceptionType}" IsVisible="{Binding HasExceptionType}" Foreground="#718096" FontSize="10" TextWrapping="Wrap" />
              <TextBlock Text="内部错误已截断。" IsVisible="{Binding Truncated}" Foreground="#856A24" FontSize="11" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </StackPanel>
    <Expander Header="{Binding GapsHeading}" IsVisible="{Binding HasGaps}" HorizontalContentAlignment="Stretch">
      <ItemsControl ItemsSource="{Binding Gaps}" Margin="8,5" AutomationProperties.AutomationId="Inspector.BindingGaps">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="150,*" Margin="0,4">
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
              <SelectableTextBlock Grid.Column="1" Text="{Binding Reason}" TextWrapping="Wrap" Margin="8,0" Foreground="#856A24" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>
    <TextBlock Text="诊断内容达到限制，部分字段、错误或子表达式已截断。" IsVisible="{Binding Truncated}" TextWrapping="Wrap" Foreground="#856A24" FontSize="11" />
    <Expander Header="{Binding ChildrenHeading}" IsVisible="{Binding HasChildren}" HorizontalContentAlignment="Stretch"
              AutomationProperties.AutomationId="Inspector.BindingChildren">
      <ItemsControl ItemsSource="{Binding Children}" Margin="10,8,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#D8DDEC" BorderThickness="2,0,0,0" Padding="12,5,0,8" Margin="0,0,0,8">
              <local:BindingDetailsView />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>
  </StackPanel>
</UserControl>
