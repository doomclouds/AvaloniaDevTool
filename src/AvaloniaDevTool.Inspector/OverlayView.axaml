<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AvaloniaDevTool.Inspector"
             x:Class="AvaloniaDevTool.Inspector.OverlayView" x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="14">
    <TextBlock Text="控件高亮与测量" FontSize="16" FontWeight="SemiBold" />
    <WrapPanel Grid.Row="1" Margin="0,10">
      <CheckBox Content="边界" IsChecked="{Binding OverlayBounds, Mode=TwoWay}" Margin="0,0,14,0" AutomationProperties.AutomationId="Inspector.OverlayBounds" />
      <CheckBox Content="Margin" IsChecked="{Binding OverlayMargin, Mode=TwoWay}" Margin="0,0,14,0" AutomationProperties.AutomationId="Inspector.OverlayMargin" />
      <CheckBox Content="Padding" IsChecked="{Binding OverlayPadding, Mode=TwoWay}" Margin="0,0,14,0" AutomationProperties.AutomationId="Inspector.OverlayPadding" />
      <CheckBox Content="信息" IsChecked="{Binding OverlayInfo, Mode=TwoWay}" Margin="0,0,14,0" AutomationProperties.AutomationId="Inspector.OverlayInfo" />
      <CheckBox Content="标尺" IsChecked="{Binding OverlayRulers, Mode=TwoWay}" Margin="0,0,14,0" AutomationProperties.AutomationId="Inspector.OverlayRulers" />
      <CheckBox Content="引导线" IsChecked="{Binding OverlayGuidelines, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.OverlayGuidelines" />
    </WrapPanel>
    <WrapPanel Grid.Row="2">
      <Button Content="显示所选控件" Command="{Binding ShowOverlayCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="Inspector.ShowOverlay" />
      <Button Content="隐藏" Command="{Binding HideOverlayCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="Inspector.HideOverlay" />
      <Button Content="读取几何" Command="{Binding RefreshOverlayCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="Inspector.RefreshOverlay" />
    </WrapPanel>
    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">
        <TextBlock Text="当前布局盒模型 · 数值单位 DIP · ? 表示属性不可用。悬停某侧只强调应用中同一侧区域，移出恢复高亮配置。示意图层宽固定，数值来自实际控件。" TextWrapping="Wrap" />
        <local:BoxModelView Snapshot="{Binding BoxModelSnapshot}" />
        <TextBlock Text="控件专用信息 · unknown 表示当前公开 API 无法安全获取；文本内容不采集。" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding BoxModelSnapshot.Info.ControlInfo.Fields}" AutomationProperties.AutomationId="Inspector.OverlayControlInformation">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="160,*,Auto" Margin="0,2">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#66758B" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding OverlaySummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="Inspector.OverlaySummary" />
        <TextBlock Text="树行悬停只预览高亮，移出后恢复当前选择。橙色区域表示 Margin，绿色区域表示 Padding；负 Margin 以重叠分区标注。工具不改写控件的布局属性，实际绘制受祖先裁剪与视口约束。" TextWrapping="Wrap" FontSize="12" Foreground="#66758B" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
