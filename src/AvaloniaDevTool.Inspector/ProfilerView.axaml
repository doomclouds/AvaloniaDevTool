<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaDevTool.Inspector.ProfilerView" x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="14">
    <WrapPanel>
      <CheckBox Content="样式匹配" IsChecked="{Binding ProfileStyleAttach, Mode=TwoWay}" Margin="0,0,12,0" AutomationProperties.AutomationId="Inspector.ProfileStyleAttach" />
      <CheckBox Content="激活器求值" IsChecked="{Binding ProfileStyleEvaluate, Mode=TwoWay}" Margin="0,0,12,0" AutomationProperties.AutomationId="Inspector.ProfileStyleEvaluate" />
      <CheckBox Content="资源查找" IsChecked="{Binding ProfileResources, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.ProfileResources" />
    </WrapPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="7">
      <TextBox Text="{Binding ProfilerFilter, Mode=TwoWay}" PlaceholderText="开始时按选择器或资源键包含文本筛选" AutomationProperties.AutomationId="Inspector.ProfilerFilter" />
      <Button Grid.Column="1" Content="开始" Command="{Binding StartProfilerCommand}" Classes="accent" AutomationProperties.AutomationId="Inspector.StartProfiler" />
      <Button Grid.Column="2" Content="停止" Command="{Binding StopProfilerCommand}" AutomationProperties.AutomationId="Inspector.StopProfiler" />
      <Button Grid.Column="3" Content="清空" Command="{Binding ClearProfilerCommand}" AutomationProperties.AutomationId="Inspector.ClearProfiler" />
      <Button Grid.Column="4" Content="刷新" Command="{Binding RefreshProfilerCommand}" AutomationProperties.AutomationId="Inspector.RefreshProfiler" />
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding ProfilerSummary}" TextWrapping="Wrap" Foreground="#66758B" FontSize="11" Margin="0,8" />
    <TabControl Grid.Row="3">
      <TabItem Header="分组统计 / 微秒">
        <ListBox ItemsSource="{Binding ProfilerGroups}" SelectedItem="{Binding SelectedProfilerGroup, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.ProfilerGroups">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="5" Spacing="5">
                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#66758B" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Outcomes}" TextWrapping="Wrap" FontSize="11" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
      <TabItem Header="原始活动 / 标签">
        <ListBox ItemsSource="{Binding ProfilerSamples}" AutomationProperties.AutomationId="Inspector.ProfilerSamples">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="5" Spacing="5">
                <WrapPanel>
                  <TextBlock Text="{Binding Time}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Category}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Duration}" FontWeight="SemiBold" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Result}" />
                </WrapPanel>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Tags}" TextWrapping="Wrap" FontSize="11" Foreground="#66758B" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="4" Text="{Binding ProfilerGroupDetails}" TextWrapping="Wrap" FontSize="11" Foreground="#856A24" Margin="0,8,0,0" MaxHeight="110" TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
