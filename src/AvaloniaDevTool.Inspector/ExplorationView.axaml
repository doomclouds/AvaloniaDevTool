<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AvaloniaDevTool.Inspector"
             x:Class="AvaloniaDevTool.Inspector.ExplorationView" x:CompileBindings="False">
  <TabControl AutomationProperties.AutomationId="Inspector.ExplorationTabs">
  <TabItem Header="动作与截图">
  <Grid RowDefinitions="Auto,Auto,180,Auto,Auto,*" Margin="14">
    <WrapPanel IsEnabled="{Binding CanUseNativeTools}">
      <Button Content="请求焦点" Command="{Binding FocusElementCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="Inspector.FocusElement" />
      <Button Content="滚动到控件" Command="{Binding BringIntoViewCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="Inspector.BringIntoView" />
      <Button Content="启用" Command="{Binding EnableElementCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="Inspector.EnableElement" />
      <Button Content="禁用" Command="{Binding DisableElementCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="Inspector.DisableElement" />
      <Button Content="刷新伪类" Command="{Binding RefreshInspectionCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="Inspector.RefreshPseudoClasses" />
    </WrapPanel>
    <TextBlock Grid.Row="1" Text="伪类/控件动作仅 Native 后端支持；外部后端可使用下方截图。" Foreground="#66758B" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" />
    <ListBox Grid.Row="2" ItemsSource="{Binding PseudoClasses}" IsEnabled="{Binding CanUseNativeTools}" AutomationProperties.AutomationId="Inspector.PseudoClasses">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="4">
            <TextBlock Text="{Binding Name}" Width="135" VerticalAlignment="Center" />
            <TextBlock Text="{Binding IsActive, StringFormat='激活：{0}'}" Width="100" VerticalAlignment="Center" />
            <TextBlock Text="{Binding IsDeclared, StringFormat='声明：{0}'}" Width="100" VerticalAlignment="Center" />
            <Button Content="切换" Command="{Binding ToggleCommand}" Padding="10,5" />
            <Button Content="恢复" Command="{Binding ResetCommand}" Padding="10,5" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Button Grid.Row="3" Content="截取所选控件" Command="{Binding CaptureElementCommand}" HorizontalAlignment="Left" Margin="0,12,0,8" AutomationProperties.AutomationId="Inspector.CaptureElement" />
    <TextBlock Grid.Row="4" Text="{Binding ElementImageSummary}" Foreground="#66758B" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
    <Border Grid.Row="5" Background="#F5F7FB" CornerRadius="6">
      <Image Source="{Binding ElementImage}" Stretch="Uniform" Margin="10" AutomationProperties.AutomationId="Inspector.ElementImage" />
    </Border>
  </Grid>
  </TabItem>
  <TabItem Header="高亮与测量" IsEnabled="{Binding CanUseNativeTools}"><local:OverlayView /></TabItem>
  <TabItem Header="渲染诊断" IsEnabled="{Binding CanUseNativeTools}"><local:RendererDiagnosticsView /></TabItem>
  <TabItem Header="弹层冻结" IsEnabled="{Binding CanUseNativeTools}"><local:PopupFreezeView /></TabItem>
  </TabControl>
</UserControl>
