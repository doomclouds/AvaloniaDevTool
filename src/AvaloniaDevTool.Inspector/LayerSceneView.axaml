<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AvaloniaDevTool.Inspector"
             x:Class="AvaloniaDevTool.Inspector.LayerSceneView" x:CompileBindings="False">
  <TabControl SelectedIndex="{Binding LayerSceneMode, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.LayerSceneMode">
  <TabItem Header="视觉几何">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
      <TextBlock Text="3D 层级几何" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding LayoutNodeLimits}" SelectedItem="{Binding LayoutNodeLimit, Mode=TwoWay}" Width="75" AutomationProperties.AutomationId="Inspector.LayoutNodeLimit" />
      <Button Grid.Column="2" Content="刷新所选子树" Command="{Binding RefreshInspectionCommand}" AutomationProperties.AutomationId="Inspector.RefreshLayout" />
      <Button Grid.Column="3" Content="重置相机" Command="{Binding ResetLayoutCameraCommand}" AutomationProperties.AutomationId="Inspector.ResetLayoutCamera" />
    </Grid>
    <StackPanel Grid.Row="1" Margin="0,8" Spacing="6">
      <TextBlock Text="{Binding LayoutSummary}" TextWrapping="Wrap" Foreground="#66758B" FontSize="11" />
      <Grid ColumnDefinitions="Auto,180,*" ColumnSpacing="9">
        <TextBlock Text="层间距" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="0" Maximum="80" Value="{Binding LayerSpacing, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.LayerSpacing" />
        <TextBlock Grid.Column="2" Text="拖动旋转 · 滚轮缩放 · 点击四边形选择" VerticalAlignment="Center" FontSize="11" Foreground="#718096" />
      </Grid>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="2*,8,*">
      <local:LayerSceneControl x:Name="LayerScene"
            Snapshot="{Binding LayoutSceneSnapshot}" LayerSpacing="{Binding LayerSpacing}"
            SelectedObjectId="{Binding SelectedLayoutObjectId, Mode=TwoWay}" ResetVersion="{Binding LayoutResetVersion}"
            AutomationProperties.AutomationId="Inspector.LayerScene" />
      <GridSplitter Grid.Column="1" Width="8" Background="Transparent" />
      <ListBox Grid.Column="2" ItemsSource="{Binding LayoutLayers}" SelectedItem="{Binding SelectedLayoutLayer, Mode=TwoWay}"
               AutomationProperties.AutomationId="Inspector.LayoutLayers">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4" Spacing="4">
              <TextBlock Text="{Binding ObjectId, StringFormat='#{0}'}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding TypeName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TypeName}" />
              <TextBlock Text="{Binding Name}" Foreground="#7761BE" TextTrimming="CharacterEllipsis" />
              <WrapPanel>
                <TextBlock Text="{Binding Depth, StringFormat='Depth {0}'}" Margin="0,0,12,0" FontSize="11" />
                <TextBlock Text="{Binding Width, StringFormat='W {0:F1}'}" Margin="0,0,12,0" FontSize="11" />
                <TextBlock Text="{Binding Height, StringFormat='H {0:F1}'}" Margin="0,0,12,0" FontSize="11" />
                <TextBlock Text="{Binding IsVisible, StringFormat='可见 {0}'}" Margin="0,0,12,0" FontSize="11" />
                <TextBlock Text="{Binding IsClipped, StringFormat='Clip {0}'}" FontSize="11" />
              </WrapPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <TextBlock Grid.Row="3" Text="半透明平面仅表示变换后的控件边界；虚线表示不可见或含裁剪标记，裁剪标记不等于逐像素裁剪结果。"
               Foreground="#856A24" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
  </Grid>
  </TabItem>
  <TabItem Header="合成图像"><local:CompositionView /></TabItem>
  </TabControl>
</UserControl>

