<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaDevTool.Inspector.PopupFreezeView" x:CompileBindings="False">
  <StackPanel Spacing="8" AutomationProperties.AutomationId="Inspector.PopupFreeze">
    <TextBlock Text="弹层保持（部分支持）" FontWeight="SemiBold" />
    <TextBlock Text="抑制 Popup / 标准 Flyout 的外部点击和失焦关闭，包含新弹层和嵌套弹层。应用主动关闭、菜单选择 / Escape 和目标卸载仍然生效；ContextMenu 的 Overlay 外部点击 / 菜单失焦处理、ToolTip 指针 / 计时关闭与 transient Flyout 移出关闭不受抑制。" TextWrapping="Wrap" FontSize="11" Foreground="#66758B" AutomationProperties.AutomationId="Inspector.PopupFreezeLimitations" />
    <ComboBox ItemsSource="{Binding PopupFreezeRoots}" SelectedItem="{Binding SelectedPopupFreezeRoot, Mode=TwoWay}"
              HorizontalAlignment="Stretch" AutomationProperties.AutomationId="Inspector.PopupFreezeRoot" />
    <StackPanel Orientation="Horizontal" Spacing="7">
      <Button Content="开启弹层保持" Command="{Binding FreezePopupsCommand}" AutomationProperties.AutomationId="Inspector.FreezePopups" />
      <Button Content="恢复所选范围" Command="{Binding ResumeSelectedPopupsCommand}" AutomationProperties.AutomationId="Inspector.ResumeSelectedPopups" />
      <Button Content="全部恢复" Command="{Binding ResumePopupsCommand}" AutomationProperties.AutomationId="Inspector.ResumePopups" />
      <Button Content="刷新" Command="{Binding RefreshPopupFreezeCommand}" AutomationProperties.AutomationId="Inspector.RefreshPopupFreeze" />
    </StackPanel>
    <TextBlock Text="{Binding PopupFreezeSummary}" TextWrapping="Wrap" FontSize="11" AutomationProperties.AutomationId="Inspector.PopupFreezeSummary" />
  </StackPanel>
</UserControl>
