<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaDevTool.Inspector.ResourcesView" x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="14">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="应用与所选控件资源作用域" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshInspectionCommand}" AutomationProperties.AutomationId="Inspector.RefreshResources" />
    </Grid>
    <StackPanel Grid.Row="1" Spacing="6" Margin="0,9,0,12">
      <TextBlock Text="{Binding ResourceSummary}" TextWrapping="Wrap" Foreground="#66758B" FontSize="12" />
      <StackPanel IsVisible="{Binding HasBindingNavigationOrigin}" Spacing="4">
        <TextBlock Text="{Binding BindingNavigationContext}" TextWrapping="Wrap" FontSize="11" Foreground="#6653C0" />
        <Button Content="返回原绑定" Command="{Binding ReturnToBindingCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="Inspector.ResourceReturnBinding" />
      </StackPanel>
      <Expander Header="绑定资源键的作用域候选" IsVisible="{Binding HasBindingResourceQuery}" IsExpanded="True" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding BindingResourceSummary}" TextWrapping="Wrap" FontSize="11" AutomationProperties.AutomationId="Inspector.BindingResourceSummary" />
          <ScrollViewer MaxHeight="160">
            <ItemsControl ItemsSource="{Binding BindingResourceMatches}" AutomationProperties.AutomationId="Inspector.BindingResourceMatches">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,3" ColumnSpacing="6">
                  <StackPanel><TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" /><TextBlock Text="{Binding Value}" TextWrapping="Wrap" /></StackPanel>
                  <Button Grid.Column="1" Content="所属字典" Command="{Binding ShowOwnerCommand}" AutomationProperties.AutomationId="Inspector.BindingResourceOwner" />
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Expander>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,0,0,8">
      <TextBox PlaceholderText="按字符串键筛选" Text="{Binding ResourceKeyFilter, Mode=TwoWay}" MaxLength="256"
               AutomationProperties.AutomationId="Inspector.ResourceKeyFilter" />
      <TextBox Grid.Column="1" PlaceholderText="按值类型筛选" Text="{Binding ResourceTypeFilter, Mode=TwoWay}" MaxLength="256"
               AutomationProperties.AutomationId="Inspector.ResourceTypeFilter" />
    </Grid>
    <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
      <CheckBox Content="包含嵌套字典" IsChecked="{Binding IncludeNestedResources, Mode=TwoWay}" Margin="0,0,12,0"
                AutomationProperties.AutomationId="Inspector.IncludeNestedResources" />
      <TextBlock Text="排序" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox ItemsSource="{Binding ResourceSortChoices}" SelectedItem="{Binding ResourceSort, Mode=TwoWay}" MinWidth="85"
                AutomationProperties.AutomationId="Inspector.ResourceSort" />
      <CheckBox Content="降序" IsChecked="{Binding ResourceSortDescending, Mode=TwoWay}" Margin="8,0,12,0"
                AutomationProperties.AutomationId="Inspector.ResourceSortDescending" />
      <Button Content="上一页" Command="{Binding PreviousResourcePageCommand}" Margin="0,0,6,0"
              AutomationProperties.AutomationId="Inspector.PreviousResourcePage" />
      <TextBlock Text="{Binding ResourcePageSummary}" VerticalAlignment="Center" Margin="0,0,6,0"
                 AutomationProperties.AutomationId="Inspector.ResourcePageSummary" />
      <Button Content="下一页" Command="{Binding NextResourcePageCommand}"
              AutomationProperties.AutomationId="Inspector.NextResourcePage" />
    </WrapPanel>
    <Grid Grid.Row="4" ColumnDefinitions="250,7,*">
      <TreeView ItemsSource="{Binding ResourceDictionaries}" SelectedItem="{Binding SelectedResourceDictionary, Mode=TwoWay}"
                AutomationProperties.AutomationId="Inspector.ResourceDictionaries">
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Margin="0,2" ToolTip.Tip="{Binding Scope}">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding EntryCount, StringFormat='{}{0} 项'}" Foreground="#718096" FontSize="11" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <GridSplitter Grid.Column="1" Background="Transparent" />
      <ListBox Grid.Column="2" ItemsSource="{Binding ResourceEntries}" BorderThickness="0" AutomationProperties.AutomationId="Inspector.ResourceEntries">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="8" BorderBrush="#E8ECF2" BorderThickness="0,0,0,1">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip.Tip="{Binding KeyType}" />
                <TextBlock Text="{Binding TypeName}" Foreground="#718096" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Provenance}" Foreground="#718096" FontSize="11" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="Inspector.ResourceProvenance" />
                <TextBlock Text="键或值预览已截断；此预览不代表完整值。" IsVisible="{Binding IsTruncated}" Foreground="#9A6500" FontSize="11" />
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                  <TextBox Text="{Binding Draft, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}" AutomationProperties.AutomationId="Inspector.ResourceValue" />
                  <Button Grid.Column="1" Content="应用" Command="{Binding ApplyCommand}" Padding="10,6" AutomationProperties.AutomationId="Inspector.ApplyResource" />
                  <Button Grid.Column="2" Content="恢复" Command="{Binding ResetCommand}" Padding="10,6" AutomationProperties.AutomationId="Inspector.ResetResource" />
                  <Button Grid.Column="3" Content="重读" Command="{Binding ReadCommand}" Padding="10,6" AutomationProperties.AutomationId="Inspector.ReadResource" />
                </Grid>
                <TextBlock Text="诊断修改" IsVisible="{Binding IsOverridden}" Foreground="#7761BE" FontSize="11" />
                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#B34150" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
