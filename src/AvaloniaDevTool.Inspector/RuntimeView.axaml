<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaDevTool.Inspector.RuntimeView" x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="14" RowSpacing="9">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
      <TextBlock Text="CLR 对象 · 只读" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="后退" Command="{Binding RuntimeBackCommand}" AutomationProperties.AutomationId="Inspector.RuntimeBack" />
      <Button Grid.Column="2" Content="所选控件" Command="{Binding RuntimeUseSelectionCommand}" AutomationProperties.AutomationId="Inspector.RuntimeSelection" />
      <Button Grid.Column="3" Content="刷新" Command="{Binding RefreshRuntimeCommand}" AutomationProperties.AutomationId="Inspector.RefreshRuntime" />
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding RuntimeBreadcrumbs}" AutomationProperties.AutomationId="Inspector.RuntimeBreadcrumbs">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding OpenCommand}" Padding="8,4" FontSize="11" /></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="4">
      <StackPanel IsVisible="{Binding HasBindingNavigationOrigin}" Spacing="4">
        <TextBlock Text="{Binding BindingNavigationContext}" TextWrapping="Wrap" FontSize="11" Foreground="#6653C0" />
        <Button Content="返回原绑定" Command="{Binding ReturnToBindingCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="Inspector.RuntimeReturnBinding" />
      </StackPanel>
      <TextBlock Text="{Binding RuntimeTitle}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.AutomationId="Inspector.RuntimeTitle" />
      <TextBlock Text="{Binding RuntimeSummary}" TextWrapping="Wrap" Foreground="#66758B" FontSize="12" AutomationProperties.AutomationId="Inspector.RuntimeSummary" />
      <TextBlock Text="{Binding RuntimeError}" IsVisible="{Binding RuntimeHasError}" TextWrapping="Wrap" Foreground="#B34150" AutomationProperties.AutomationId="Inspector.RuntimeError" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding RuntimeIsLoading}" Height="3" />
    </StackPanel>
    <ComboBox Grid.Row="3" ItemsSource="{Binding RuntimeSections}" SelectedIndex="{Binding RuntimeSectionIndex, Mode=TwoWay}"
              HorizontalAlignment="Stretch" AutomationProperties.AutomationId="Inspector.RuntimeSection" />
    <TextBlock Grid.Row="4" Text="按需执行本页公共 getter；双击或打开值进入嵌套对象。弱 ID 可能被回收，截断预览不是完整值。"
               TextWrapping="Wrap" Foreground="#728096" FontSize="11" />
    <ListBox x:Name="RuntimeList" Grid.Row="5" ItemsSource="{Binding RuntimeRows}" BorderThickness="0"
             DoubleTapped="OpenRuntimeValue" AutomationProperties.AutomationId="Inspector.RuntimeRows">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="8" BorderBrush="#E8ECF2" BorderThickness="0,0,0,1">
            <StackPanel Spacing="5">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#718096" TextWrapping="Wrap" />
              <Grid IsVisible="{Binding HasKey}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding KeyPreview, StringFormat='键：{0}'}" TextWrapping="Wrap" ToolTip.Tip="{Binding KeyTypeName}" />
                  <TextBlock Text="{Binding KeyFlags}" FontSize="11" Foreground="#8172CA" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="打开键" Command="{Binding OpenKeyCommand}" Padding="8,4" VerticalAlignment="Center" AutomationProperties.AutomationId="Inspector.RuntimeOpenKey" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip.Tip="{Binding TypeName}" AutomationProperties.AutomationId="Inspector.RuntimeValue" />
                <Button Grid.Column="1" Content="{Binding OpenLabel}" Command="{Binding OpenCommand}" Padding="8,4" AutomationProperties.AutomationId="Inspector.RuntimeOpenValue" />
              </Grid>
              <TextBlock Text="{Binding TypeName}" FontSize="11" Foreground="#718096" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Flags}" FontSize="11" Foreground="#8172CA" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#B34150" TextWrapping="Wrap" AutomationProperties.AutomationId="Inspector.RuntimeRowError" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <Button Content="上一页" Command="{Binding RuntimePreviousPageCommand}" AutomationProperties.AutomationId="Inspector.RuntimePrevious" />
      <TextBlock Grid.Column="1" Text="{Binding RuntimePageText}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="#66758B" AutomationProperties.AutomationId="Inspector.RuntimePage" />
      <Button Grid.Column="2" Content="下一页" Command="{Binding RuntimeNextPageCommand}" AutomationProperties.AutomationId="Inspector.RuntimeNext" />
    </Grid>
  </Grid>
</UserControl>
