<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AvaloniaDevTool.Inspector"
             x:Class="AvaloniaDevTool.Inspector.MetricsView" x:CompileBindings="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                AutomationProperties.AutomationId="Inspector.MetricsPageScroll">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,220,Auto,280" Margin="14">
    <Grid ColumnDefinitions="*,*,Auto,Auto,Auto" ColumnSpacing="7">
      <TextBox Text="{Binding MeterFilter, Mode=TwoWay}" PlaceholderText="Meter 名称，逗号分隔，支持 *" AutomationProperties.AutomationId="Inspector.MeterFilter" />
      <TextBox Grid.Column="1" Text="{Binding InstrumentFilter, Mode=TwoWay}" PlaceholderText="Instrument 名称，支持 *" AutomationProperties.AutomationId="Inspector.InstrumentFilter" />
      <Button Grid.Column="2" Content="开始" Command="{Binding StartMetricsCommand}" Classes="accent" AutomationProperties.AutomationId="Inspector.StartMetrics" />
      <Button Grid.Column="3" Content="停止" Command="{Binding StopMetricsCommand}" AutomationProperties.AutomationId="Inspector.StopMetrics" />
      <Button Grid.Column="4" Content="刷新" Command="{Binding RefreshInspectionCommand}" AutomationProperties.AutomationId="Inspector.RefreshMetrics" />
    </Grid>
    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
      <StackPanel Margin="0,0,10,6"><TextBlock Text="Observable 轮询 ms" FontSize="10" /><NumericUpDown Value="{Binding MetricsPollIntervalMs, Mode=TwoWay}" Minimum="100" Maximum="60000" Increment="100" Width="140" AutomationProperties.AutomationId="Inspector.MetricsPollInterval" /></StackPanel>
      <StackPanel Margin="0,0,10,6"><TextBlock Text="样本通知 ms" FontSize="10" /><NumericUpDown Value="{Binding MetricsNotificationIntervalMs, Mode=TwoWay}" Minimum="50" Maximum="5000" Increment="50" Width="140" AutomationProperties.AutomationId="Inspector.MetricsNotificationInterval" /></StackPanel>
      <StackPanel Margin="0,0,10,6"><TextBlock Text="显示 / 聚合帧 ms" FontSize="10" /><NumericUpDown Value="{Binding MetricsFrameIntervalMs, Mode=TwoWay}" Minimum="10" Maximum="60000" Increment="50" Width="140" AutomationProperties.AutomationId="Inspector.MetricsFrameInterval" /></StackPanel>
      <StackPanel Margin="0,0,10,6"><TextBlock Text="历史时间窗 ms" FontSize="10" /><NumericUpDown Value="{Binding MetricsHistoryWindowMs, Mode=TwoWay}" Minimum="100" Maximum="600000" Increment="1000" Width="150" AutomationProperties.AutomationId="Inspector.MetricsHistoryWindow" /></StackPanel>
      <CheckBox Content="帧聚合（下次开始生效）" IsChecked="{Binding MetricsAggregateFrames, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.MetricsAggregateFrames" />
    </WrapPanel>
    <TextBlock Grid.Row="2" Text="{Binding MetricsSummary}" Foreground="#66758B" FontSize="11" TextWrapping="Wrap" Margin="0,8" />
    <TextBlock Grid.Row="3" Text="{Binding MetricChartSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,7" />
    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding MetricCharts}" AutomationProperties.AutomationId="Inspector.MetricCharts">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid RowDefinitions="Auto,110,Auto" Margin="0,0,0,12">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" /><Button Grid.Column="1" Content="清空此图" Command="{Binding ClearCommand}" AutomationProperties.AutomationId="Inspector.ClearMetricChart" /></Grid>
              <local:MetricLineChart Grid.Row="1" Points="{Binding Points}" WindowStart="{Binding WindowStart}" WindowEnd="{Binding WindowEnd}" AutomationProperties.AutomationId="Inspector.MetricChart" />
              <TextBlock Grid.Row="2" Text="{Binding Axis}" FontSize="10" Foreground="#718096" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="5" Text="min / max / mean / p50 / p90 / p95 使用真实时窗内仍保留的原始样本，nearest-rank。聚合仅改变绘图：Histogram 帧内平均，Counter/Gauge 帧内末值；Counter 末值仍是原始增量。时间窗仍受最多 1024 条原始样本容量限制。所有设置下次开始生效。" TextWrapping="Wrap" Foreground="#856A24" FontSize="11" Margin="0,8" />
    <TabControl Grid.Row="6">
      <TabItem Header="序列 / 保留窗口统计">
        <ListBox ItemsSource="{Binding MetricSeries}" SelectedItem="{Binding SelectedMetricSeries, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.MetricSeries">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="5" Spacing="5">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Tags}" FontSize="11" Foreground="#66758B" />
                <WrapPanel>
                  <TextBlock Text="{Binding WindowCount, StringFormat='样本 {0}'}" Margin="0,0,15,0" />
                  <TextBlock Text="{Binding Last, StringFormat='latest {0}'}" Margin="0,0,15,0" />
                  <TextBlock Text="{Binding Minimum, StringFormat='min {0}'}" Margin="0,0,15,0" />
                  <TextBlock Text="{Binding Maximum, StringFormat='max {0}'}" Margin="0,0,15,0" />
                  <TextBlock Text="{Binding Mean, StringFormat='mean {0}'}" Margin="0,0,15,0" />
                  <TextBlock Text="{Binding P50, StringFormat='p50 {0}'}" Margin="0,0,15,0" />
                  <TextBlock Text="{Binding P90, StringFormat='p90 {0}'}" Margin="0,0,15,0" />
                  <TextBlock Text="{Binding P95, StringFormat='p95 {0}'}" />
                </WrapPanel>
                <TextBlock Text="{Binding Scope}" FontSize="10" Foreground="#718096" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
      <TabItem Header="仪表">
        <ListBox ItemsSource="{Binding MetricInstruments}" AutomationProperties.AutomationId="Inspector.MetricInstruments">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="5" Spacing="5">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding MeterName}" FontSize="11" Foreground="#718096" />
                <WrapPanel>
                  <TextBlock Text="{Binding Kind}" Margin="0,0,15,0" />
                  <TextBlock Text="{Binding Unit, StringFormat='单位 {0}'}" Margin="0,0,15,0" />
                  <TextBlock Text="{Binding IsActive, StringFormat='活动 {0}'}" />
                </WrapPanel>
                <TextBlock Text="{Binding ValueSemantics}" TextWrapping="Wrap" FontSize="11" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
      <TabItem Header="原始样本 / 标签">
        <ListBox ItemsSource="{Binding MetricSamples}" AutomationProperties.AutomationId="Inspector.MetricSamples">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="5" Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" FontSize="11" />
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding RawValue}" />
                  <TextBlock Text="{Binding NumericType}" FontSize="11" Foreground="#718096" />
                </StackPanel>
                <TextBlock Text="{Binding Tags}" FontSize="11" Foreground="#718096" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
    </TabControl>
  </Grid>
  </ScrollViewer>
</UserControl>
