<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AvaloniaDevTool.Inspector"
             x:Class="AvaloniaDevTool.Inspector.StylesView" x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,*" Margin="14">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="样式帧与绑定诊断" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshInspectionCommand}" AutomationProperties.AutomationId="Inspector.RefreshStyles" />
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding StyleSummary}" TextWrapping="Wrap" Foreground="#66758B" FontSize="12" Margin="0,9,0,12" />
    <ScrollViewer Grid.Row="2">
      <StackPanel Spacing="12">
        <TextBlock Text="值相同仅表示 setter 与当前值一致，不表示它是唯一生效的 setter。" TextWrapping="Wrap" Foreground="#856A24" FontSize="12" />
        <CheckBox Content="仅显示活动样式帧" IsChecked="{Binding ActiveStyleFramesOnly, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.ActiveStyleFramesOnly" />
        <TextBlock Text="框架诊断仅列出具有值的 setter；未返回的无值条目不能判断为有效或无效。" TextWrapping="Wrap" Foreground="#718096" FontSize="11" />
        <ItemsControl ItemsSource="{Binding FilteredStyleFrames}" AutomationProperties.AutomationId="Inspector.StyleFrames">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#E0E5EE" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,10">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Source}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding Kind}" Foreground="#6653C0" />
                    <TextBlock Text="{Binding Priority}" />
                    <TextBlock Text="{Binding IsActive, StringFormat='活动：{0}'}" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Setters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="180,*,Auto" Margin="0,4">
                          <TextBlock Text="{Binding PropertyName}" ToolTip.Tip="{Binding DeclaringType}" />
                          <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Margin="8,0" />
                          <TextBlock Grid.Column="2" Text="{Binding MatchesEffectiveValue, TargetNullValue=未知, StringFormat='值相同：{0}'}" Foreground="#718096" FontSize="11" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="绑定表达式" FontWeight="SemiBold" FontSize="15" />
        <WrapPanel Orientation="Horizontal">
          <CheckBox Content="仅运行中的绑定" IsChecked="{Binding RunningBindingsOnly, Mode=TwoWay}" Margin="0,0,14,0" AutomationProperties.AutomationId="Inspector.RunningBindingsOnly" />
          <CheckBox Content="仅明确错误绑定" IsChecked="{Binding ErrorBindingsOnly, Mode=TwoWay}" AutomationProperties.AutomationId="Inspector.ErrorBindingsOnly" />
        </WrapPanel>
        <ItemsControl ItemsSource="{Binding FilteredBindingDiagnostics}" AutomationProperties.AutomationId="Inspector.Bindings">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <local:BindingDiagnosticView />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="数据校验错误" FontWeight="SemiBold" FontSize="15" />
        <ItemsControl ItemsSource="{Binding ValidationErrors}" AutomationProperties.AutomationId="Inspector.ValidationErrors" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

