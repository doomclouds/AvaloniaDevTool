<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>AvaloniaDevTool.Cli</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference
            Include="../AvaloniaDevTool.Infrastructure.Execution/AvaloniaDevTool.Infrastructure.Execution.csproj" />
        <ProjectReference Include="../../Application/AvaloniaDevTool.Application/AvaloniaDevTool.Application.csproj" />
        <PackageReference Include="ModelContextProtocol"
            Version="2.3.0" />
        <PackageReference Include="ModelContextProtocol.AspNetCore"
            Version="2.3.0" />
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <InternalsVisibleTo Include="AvaloniaDevTool.Cli" />
        <InternalsVisibleTo Include="AvaloniaDevTool.Cli.Tests" />
