<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../AvaloniaDevTool.Client/AvaloniaDevTool.Client.csproj" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="XamlMcp.Protocol" Version="1.0.0-preview.3" />
    <PackageDownload Include="XamlMcp.Server" Version="[1.0.0-preview.3]" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)/xamlmcp.server/1.0.0-preview.3/tools/net10.0/any/**/*"
             Link="Upstream/XamlMcpServer/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="AvaloniaDevTool.Backends.XamlMcp.Tests" />
    <None Update="ThirdParty/*" Link="Upstream/XamlMcpServer/ThirdParty/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

