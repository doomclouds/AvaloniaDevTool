<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType></PropertyGroup>
  <PropertyGroup>
    <BuildNativeWorker Condition="'$(BuildNativeWorker)' == '' and '$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">true</BuildNativeWorker>
    <BuildNativeWorker Condition="'$(BuildNativeWorker)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">true</BuildNativeWorker>
    <BuildNativeWorker Condition="'$(BuildNativeWorker)' == ''">false</BuildNativeWorker>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <ProjectReference Include="../AvaloniaDevTool.Client/AvaloniaDevTool.Client.csproj" />
    <ProjectReference Include="../AvaloniaDevTool.NativeAutomation/AvaloniaDevTool.NativeAutomation.csproj" />
    <ProjectReference Include="../AvaloniaDevTool.NativeAutomation.Worker/AvaloniaDevTool.NativeAutomation.Worker.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Condition="'$(BuildNativeWorker)' == 'true'" />
    <ProjectReference Include="../AvaloniaDevTool.Previewer/AvaloniaDevTool.Previewer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyPreviewHost" AfterTargets="Build">
    <MSBuild Projects="../AvaloniaDevTool.Previewer/AvaloniaDevTool.Previewer.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="PreviewHostTarget" />
    </MSBuild>
    <PropertyGroup><PreviewHostOutput>@(PreviewHostTarget->'%(RootDir)%(Directory)')</PreviewHostOutput></PropertyGroup>
    <ItemGroup><PreviewHostFiles Include="$(PreviewHostOutput)**/*" Exclude="$(PreviewHostOutput)**/*.pdb" /></ItemGroup>
    <Copy SourceFiles="@(PreviewHostFiles)" DestinationFiles="@(PreviewHostFiles->'$(OutDir)previewer/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <None Update="ThirdParty/*" TargetPath="ThirdParty/AvaloniaDevTool.Cli/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Contracts/official-input-contracts.json" />
  </ItemGroup>
  <Target Name="PublishPreviewHost" AfterTargets="Publish">
    <ItemGroup><PublishedPreviewFiles Include="$(OutDir)previewer/**/*" /></ItemGroup>
    <Copy SourceFiles="@(PublishedPreviewFiles)" DestinationFiles="@(PublishedPreviewFiles->'$(PublishDir)previewer/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyNativeWorker" AfterTargets="Build" Condition="'$(BuildNativeWorker)' == 'true'">
    <MSBuild Projects="../AvaloniaDevTool.NativeAutomation.Worker/AvaloniaDevTool.NativeAutomation.Worker.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows7.0">
      <Output TaskParameter="TargetOutputs" ItemName="NativeWorkerTarget" />
    </MSBuild>
    <PropertyGroup><NativeWorkerOutput>@(NativeWorkerTarget->'%(RootDir)%(Directory)')</NativeWorkerOutput></PropertyGroup>
    <ItemGroup><NativeWorkerFiles Include="$(NativeWorkerOutput)**/*" Exclude="$(NativeWorkerOutput)**/*.pdb" /></ItemGroup>
    <Copy SourceFiles="@(NativeWorkerFiles)" DestinationFiles="@(NativeWorkerFiles->'$(OutDir)native-worker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishNativeWorker" AfterTargets="Publish" Condition="'$(BuildNativeWorker)' == 'true'">
    <ItemGroup><PublishedNativeWorkerFiles Include="$(OutDir)native-worker/**/*" /></ItemGroup>
    <Copy SourceFiles="@(PublishedNativeWorkerFiles)" DestinationFiles="@(PublishedNativeWorkerFiles->'$(PublishDir)native-worker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>

